# Dependency directories
node_modules/

# Environment files (exclude .env.example)
.env*
!.env.example

# Production builds and outputs
dist/
build/
.next/
coverage/

# Uploads and temporary media (keep directories via .gitkeep, ignore files)
uploads/videos/*
uploads/decks/*
!uploads/videos/.gitkeep
!uploads/decks/.gitkeep

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS-specific files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
